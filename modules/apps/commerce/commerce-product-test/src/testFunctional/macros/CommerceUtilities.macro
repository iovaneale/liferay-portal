definition {

	macro checkSuccessAlertAppearsAndDisappears {
		WaitForElementPresent(locator1 = "Message#SUCCESS");

		WaitForElementNotPresent(locator1 = "Message#SUCCESS");
	}

	macro waitAndRefresh {
		while ("${actualValue}" != "${expectedValue}") {
			Pause(locator1 = "5000");

			Refresh();
		}
	}

}